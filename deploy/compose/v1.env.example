# Copy to an ignored local env file and fill every blank secret with an
# independently generated random value. Blank values intentionally make
# `docker compose config` and startup fail closed.

TRAVEL_PLANNING_IMAGE_TAG=local
TRAVEL_PLANNING_POSTGRES_PORT=35434
TRAVEL_PLANNING_REDIS_PORT=36379
TRAVEL_PLANNING_API_PORT=38083
TRAVEL_PLANNING_WEB_PORT=33003

# Generate independent 32-byte hex values (for example: `openssl rand -hex 32`).
TRAVEL_PLANNING_POSTGRES_ADMIN_PASSWORD=
TRAVEL_PLANNING_MIGRATION_DB_PASSWORD=
TRAVEL_PLANNING_API_DB_PASSWORD=
TRAVEL_PLANNING_WORKER_DB_PASSWORD=
TRAVEL_PLANNING_OUTBOX_DB_PASSWORD=
TRAVEL_PLANNING_REDIS_PASSWORD=
TRAVEL_PLANNING_V1_DEV_BFF_SECRET=
TRAVEL_PLANNING_SHARE_PEPPER=
# Optional server-only AMap Web Service key. Keep this blank in the committed
# example and set it only in the ignored deploy/compose/.env.v1.local file.
TRAVEL_PLANNING_AMAP_WEB_KEY=
# Keep the allowlist explicit. Unknown provider IDs fail configuration validation.
TRAVEL_PLANNING_PROVIDER_ALLOWLIST=amap
TRAVEL_PLANNING_AMAP_HTTP_TIMEOUT_SECONDS=3.0
# Optional bounded Research directive: one call per new Run, thinking disabled.
TRAVEL_PLANNING_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
TRAVEL_PLANNING_LLM_API_KEY=
TRAVEL_PLANNING_LLM_MODEL=deepseek-v4-flash
TRAVEL_PLANNING_LLM_MAX_OUTPUT_TOKENS=96
TRAVEL_PLANNING_ANSWER_MAX_OUTPUT_TOKENS=320
# Used only by the built-in Web OIDC BFF in pre-production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TRAVEL_PLANNING_OIDC_COOKIE_KEY=
TRAVEL_PLANNING_OIDC_CLIENT_SECRET=
# Worker recovery controls. Reclaim should not be shorter than the reviewed
# lease/heartbeat policy; validate changes with recovery tests.
TRAVEL_PLANNING_V1_RUN_LEASE_SECONDS=60
TRAVEL_PLANNING_V1_RUN_RECLAIM_IDLE_MILLISECONDS=60000
TRAVEL_PLANNING_LOG_LEVEL=INFO
TRAVEL_PLANNING_EMBEDDING_ENDPOINT=
TRAVEL_PLANNING_EMBEDDING_API_KEY=
TRAVEL_PLANNING_EMBEDDING_MODEL=
TRAVEL_PLANNING_EMBEDDING_MODEL_VERSION=

# Local-only server-derived identity. Never enable this path in pre-production.
TRAVEL_PLANNING_DEV_TENANT=local-tenant
TRAVEL_PLANNING_DEV_USER=local-user

# Used only with v1.preprod.yaml. These endpoint/identifier values are not bearer secrets.
TRAVEL_PLANNING_OIDC_ISSUER=https://identity.example.invalid/
TRAVEL_PLANNING_OIDC_AUDIENCE=travel-planning-api
TRAVEL_PLANNING_OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
TRAVEL_PLANNING_OIDC_AUTHORIZATION_URL=https://identity.example.invalid/oauth2/authorize
TRAVEL_PLANNING_OIDC_TOKEN_URL=https://identity.example.invalid/oauth2/token
TRAVEL_PLANNING_OIDC_END_SESSION_URL=https://identity.example.invalid/oauth2/logout
TRAVEL_PLANNING_OIDC_CLIENT_ID=travel-planning-web
TRAVEL_PLANNING_OIDC_SCOPES=openid profile email offline_access
TRAVEL_PLANNING_OIDC_ALGORITHMS=RS256,ES256
TRAVEL_PLANNING_PUBLIC_ORIGIN=https://travel.example.invalid
