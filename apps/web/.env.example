# Server-only. Never rename these to NEXT_PUBLIC_*.
TRAVEL_PLANNING_API_ORIGIN=http://127.0.0.1:38083
TRAVEL_PLANNING_DEPLOYMENT_ENV=local
# Optional canonical browser origin behind a reverse proxy. When omitted, the
# BFF compares the Origin header with the request Host header.
# TRAVEL_PLANNING_PUBLIC_ORIGIN=https://travel.example.com

# Local development identity injection is disabled unless all four values are set.
# Never enable it in production. The FastAPI process separately needs
# TRAVEL_PLANNING_V1_DEV_AUTH=1; non-loopback container traffic is accepted only
# when the same TRAVEL_PLANNING_V1_DEV_BFF_SECRET is presented.
TRAVEL_PLANNING_BFF_DEV_AUTH=0
TRAVEL_PLANNING_BFF_DEV_TENANT=local-tenant
TRAVEL_PLANNING_BFF_DEV_USER=local-user
TRAVEL_PLANNING_BFF_DEV_ROLES=owner
# Required only when local development identity injection is enabled. Generate
# at least 32 random bytes; never reuse this value outside one local stack.
TRAVEL_PLANNING_V1_DEV_BFF_SECRET=

# This file defaults to a local HTTP-compatible name. Staging/production must use
# `__Host-travel_planning_access_token` (the preprod Compose overlay sets it) and the
# BFF refuses any non-`__Host-` name there. Access JWT storage is always HttpOnly
# and SameSite=Strict; secure deployments additionally force Secure.
TRAVEL_PLANNING_ACCESS_TOKEN_COOKIE_NAME=travel_planning_access_token_dev

# OIDC is mandatory in staging/production. It can be exercised locally by setting
# TRAVEL_PLANNING_OIDC_ENABLED=1 and disabling development identity. Endpoints are
# explicit by design: discovery is not fetched and redirects are not followed.
TRAVEL_PLANNING_OIDC_ENABLED=0
TRAVEL_PLANNING_OIDC_ISSUER=https://identity.example.com/
TRAVEL_PLANNING_OIDC_AUTHORIZATION_URL=https://identity.example.com/oauth2/authorize
TRAVEL_PLANNING_OIDC_TOKEN_URL=https://identity.example.com/oauth2/token
TRAVEL_PLANNING_OIDC_END_SESSION_URL=https://identity.example.com/oauth2/logout
TRAVEL_PLANNING_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
TRAVEL_PLANNING_OIDC_CLIENT_ID=travel-planning-web
TRAVEL_PLANNING_OIDC_CLIENT_SECRET=
TRAVEL_PLANNING_OIDC_SCOPES=openid profile email offline_access
TRAVEL_PLANNING_OIDC_ALGORITHMS=RS256,ES256
# Exactly 32 random bytes encoded as unpadded base64url. Never reuse it.
TRAVEL_PLANNING_OIDC_COOKIE_KEY=
