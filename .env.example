# Travel-Planning V1 direct-process configuration.
#
# Docker Compose users should copy deploy/compose/v1.env.example instead. Never
# commit a populated .env file. All keys and passwords below are server-only.

# -----------------------------------------------------------------------------
# Service and deployment
# -----------------------------------------------------------------------------
ENVIRONMENT=dev
TRAVEL_PLANNING_DEPLOYMENT_ENV=local
TRAVEL_PLANNING_WEB_HOST=0.0.0.0
TRAVEL_PLANNING_WEB_PORT=38083
CORS_ORIGINS=http://127.0.0.1:33003

TRAVEL_PLANNING_API_ORIGIN=http://127.0.0.1:38083
TRAVEL_PLANNING_PUBLIC_ORIGIN=http://127.0.0.1:33003

# -----------------------------------------------------------------------------
# PostgreSQL and Redis
# Schema is managed only by deploy/migrations. RAG and A2A fall back to the V1
# DSN when their dedicated DSN is blank.
# -----------------------------------------------------------------------------
TRAVEL_PLANNING_V1_DATABASE_URL=
TRAVEL_PLANNING_RAG_DATABASE_URL=
TRAVEL_PLANNING_A2A_DATABASE_URL=
TRAVEL_PLANNING_OUTBOX_DATABASE_URL=
TRAVEL_PLANNING_REDIS_URL=
TRAVEL_PLANNING_SHARE_PEPPER=
# Optional. When set, enables /api/metrics and must contain at least 32 characters.
TRAVEL_PLANNING_METRICS_TOKEN=

# External Run worker recovery. Reclaim idle should normally be >= lease.
TRAVEL_PLANNING_V1_RUN_LEASE_SECONDS=60
TRAVEL_PLANNING_V1_RUN_RECLAIM_IDLE_MILLISECONDS=60000

# -----------------------------------------------------------------------------
# Runtime and server-only travel providers
# -----------------------------------------------------------------------------
TRAVEL_PLANNING_V1_EXECUTION_MODE=inline
TRAVEL_PLANNING_V1_EXECUTION_PROFILE=v2_research_planning
# Optional and server-only. Put the real value in an ignored local env file;
# never use AMAP_API_KEY or a NEXT_PUBLIC_* variable.
TRAVEL_PLANNING_AMAP_WEB_KEY=
TRAVEL_PLANNING_PROVIDER_ALLOWLIST=amap
TRAVEL_PLANNING_AMAP_HTTP_TIMEOUT_SECONDS=3.0

# Optional bounded model assistance for the Research Agent. The model output is
# only a short Provider/RAG query, never user-facing evidence or a final plan.
TRAVEL_PLANNING_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
TRAVEL_PLANNING_LLM_API_KEY=
TRAVEL_PLANNING_LLM_MODEL=deepseek-v4-flash
TRAVEL_PLANNING_LLM_MAX_OUTPUT_TOKENS=96
TRAVEL_PLANNING_ANSWER_MAX_OUTPUT_TOKENS=320

# RAG lexical search always remains explicit. Semantic retrieval additionally
# requires an OpenAI-compatible embeddings endpoint that returns exactly 384
# dimensions; when absent, retrieval reports lexical-only degradation.
TRAVEL_PLANNING_RAG_CORPUS_REVISION=travel-planning-travel-zh@2026.07.2
TRAVEL_PLANNING_EMBEDDING_ENDPOINT=
TRAVEL_PLANNING_EMBEDDING_API_KEY=
TRAVEL_PLANNING_EMBEDDING_MODEL=
TRAVEL_PLANNING_EMBEDDING_MODEL_VERSION=
TRAVEL_PLANNING_EMBEDDING_DIMENSION=384
TRAVEL_PLANNING_EMBEDDING_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Local-only BFF identity
# Generate TRAVEL_PLANNING_V1_DEV_BFF_SECRET with at least 32 random bytes and use
# the same value in API and Web. Both dev-auth flags must be 0 outside local.
# -----------------------------------------------------------------------------
TRAVEL_PLANNING_V1_DEV_AUTH=0
TRAVEL_PLANNING_BFF_DEV_AUTH=0
TRAVEL_PLANNING_V1_DEV_BFF_SECRET=
TRAVEL_PLANNING_BFF_DEV_TENANT=local-tenant
TRAVEL_PLANNING_BFF_DEV_USER=local-user
TRAVEL_PLANNING_BFF_DEV_ROLES=owner

# -----------------------------------------------------------------------------
# OIDC API validation and Web Authorization Code + PKCE
# All endpoint URLs are explicit HTTPS URLs in staging/production. The cookie
# key is exactly 32 random bytes encoded as unpadded base64url.
# -----------------------------------------------------------------------------
TRAVEL_PLANNING_OIDC_ISSUER=
TRAVEL_PLANNING_OIDC_AUDIENCE=travel-planning-api
TRAVEL_PLANNING_OIDC_JWKS_URL=
TRAVEL_PLANNING_OIDC_ALGORITHMS=RS256,ES256
TRAVEL_PLANNING_OIDC_TENANT_CLAIM=tenant_id
TRAVEL_PLANNING_OIDC_ROLES_CLAIM=roles
TRAVEL_PLANNING_OIDC_AUTHORIZATION_EPOCH_CLAIM=authorization_epoch

TRAVEL_PLANNING_OIDC_AUTHORIZATION_URL=
TRAVEL_PLANNING_OIDC_TOKEN_URL=
TRAVEL_PLANNING_OIDC_END_SESSION_URL=
TRAVEL_PLANNING_OIDC_CLIENT_ID=travel-planning-web
TRAVEL_PLANNING_OIDC_CLIENT_SECRET=
TRAVEL_PLANNING_OIDC_SCOPES=openid profile email offline_access
TRAVEL_PLANNING_OIDC_COOKIE_KEY=
TRAVEL_PLANNING_ACCESS_TOKEN_COOKIE_NAME=travel_planning_access_token_dev

# -----------------------------------------------------------------------------
# Offline historical-data import only. This is not read by the product runtime.
# Use a read-only source credential; the tool never deletes source data.
# -----------------------------------------------------------------------------
TRAVEL_PLANNING_LEGACY_DATABASE_URL=
